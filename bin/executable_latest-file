#!/usr/bin/env python3

import argparse
from pathlib import Path


def mtime(path: Path) -> float:
    return path.stat().st_mtime


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Print the file with the latest modification date"
    )
    parser.add_argument("files", type=Path, nargs="+", help="Files to compare")

    args = parser.parse_args()

    latest = max(args.files, key=mtime)
    print(latest)


if __name__ == "__main__":
    main()

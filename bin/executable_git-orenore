#!/usr/bin/env bash

root=$(git rev-parse --show-toplevel)
dot_git="${root}/.git"

while [ -f "$dot_git" ]
do
  dot_git="$(head -1 "$dot_git" | sed 's/gitdir: //')"
done

mkdir -p "$dot_git/info"

if [ -p /proc/self/fd/0 ]
then
  cat >> "$dot_git/info/exclude"
else
  if [ "$#" -gt 0 ]
  then
    for it in "$@"
    do
      relpath="$(realpath --relative-to "$root" "$it")"
      echo "$relpath" | tee -a "$dot_git/info/exclude"
      echo "Added: ${relpath}"
    done
  fi
fi

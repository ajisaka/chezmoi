# 同じ TMUX セッションであれば、プロファイルを使いまわす

if has-command hugo
then
  function __initialize_aws_env () {
    local profile="$(hugo zsh-aws-env get "PROFILE")"
    [ -n "$profile" ] && export AWS_PROFILE="$profile"
    local region="$(hugo zsh-aws-env get "REGION")"
    if [ -n "$region" ]
    then
      export AWS_DEFAULT_REGION="$region"
    else
      [ -z "$AWS_DEFAULT_REGION" ] && export AWS_DEFAULT_REGION=ap-northeast-1
    fi
  }

  function __set_aws_profile_automatically() {
    local profile
    local target_dir="$PWD"
    local depth=0
    while [ "$target_dir" != '/' ] && [ "$depth" -lt 5 ]
    do
      profile="$(hugo aws-profile-for-directory get "$target_dir")"
      if [ -n "$profile" ]
      then
        export AWS_PROFILE="$profile"
        break
      fi
      target_dir="$(dirname "$target_dir")"
      depth="$(( depth + 1 ))"
    done
  }

  add-zsh-hook chpwd __set_aws_profile_automatically
fi


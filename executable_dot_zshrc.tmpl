# RPN 電卓 {{{

function _calc {
  if [[ -z $@ ]] then
    dc | while read r
    do
      echo -e "\e[2m"$(( $r )) 0x$(([##16] $r )) 0b$(([##2] $r ))"\e[m"
    done
  else
    #echo $(( $@ )) 0x$(([##16] $@ )) 0b$(([##2] $@ ))
    local R=`dc -e "$* p"`
    local LR=`echo $R | tail -n 1`
    echo $R | head -n -1
    echo -e "\e[2m"$(( $LR )) 0x$(([##16] $LR )) 0b$(([##2] $LR ))"\e[m"
  fi
}

function _rpncalc () {
  /bin/rpncalc "$@"
}


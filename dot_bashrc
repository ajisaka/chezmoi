# Script finder {{{
find_script() {
  local home=~/
  local root roots=()
  for root in ~/script/ ~/local/script/ ~/bin/ ~/lin/ ~/local/bin/
  do
    [ -e "$root" ] && roots+=("$root")
  done

  {
    find "${roots[@]}" \( -type f -executable -or -type l \) | sed "s/^.\{${#home}\}//" | sed -e 's/^/!/'
    (
      alias -p | sed 's/^alias *//' | sed 's/=.*//'
    ) | grep '^[a-z]' | sort | sed -e 's/^/#/'
  } | grep '.\+'
}

select_script () {
  local found
  local cmd
  found=$(find_script | anything)
  found_type="${found:0:1}"
  found_path="${found:1}"
  if [ "$found_type" = '#' ]
  then
    cmd="$found_path"
  elif [[ $found_path =~ (^|/)bin/ ]]
  then
    cmd="$(basename "$found_path")"
  else
  # shellcheck disable=2088
    cmd="~/$found_path"
  fi
  if [ -z "$READLINE_LINE" ]
  then
    READLINE_LINE="$cmd"
  else
    READLINE_LINE="${READLINE_LINE} ${cmd}"
  fi
  READLINE_POINT="${#READLINE_LINE}"
  # zle -R -c               # refresh
}

bind -x '"\C-s": select_script'

# }}}

# コマンド履歴検索 {{{
_replace_by_history() {
  local line
  line="$(
    HISTTIMEFORMAT='' history \
      | sort -k1,1nr \
      | sed -e 's/^[[:space:]]*[0-9]\+[[:space:]]*//' \
      | unique \
      | anything
  )"
  READLINE_LINE="$line"
  READLINE_POINT=${#line}
}
bind -x '"\C-r": _replace_by_history' # Override `<C-r>`

  md5sum -b "$@" | cut -d ' ' -f1 | tr --delete "\n" | clipboard-push
  echo
}

function copy-sha256sum () {
  sha256sum -b "$@" | cut -d ' ' -f1 | tr --delete "\n" | clipboard-push

[Unit]
Description=XXXXXX

[Timer]
OnCalendar=*-*-* 2,14:00
OnCalendar=weekly
OnCalendar=Mon,Tue *-*-01..04 12:00:00        # 毎月の1日から4日まで、月曜日か火曜日の場合にのみ、午後0時にサービスを実行します
OnCalendar=Sat *-*-1..7 18:00:00              # 毎月第1土曜日

OnUnitActiveSec=10s                           # 実行間隔
OnUnitActiveSec=1w

Persistent=true                               # 起動時間が過ぎていたらすぐに起動

OnBootSec=15min                               # システム起動後 15min 待機する

[Install]
WantedBy=timers.target


# https://wiki.archlinux.jp/index.php/Systemd/%E3%82%BF%E3%82%A4%E3%83%9E%E3%83%BC#.E3.83.A2.E3.83.8E.E3.83.88.E3.83.8B.E3.83.83.E3.82.AF.E3.82.BF.E3.82.A4.E3.83.9E.E3.83.BC
# https://jlk.fjfi.cvut.cz/arch/manpages/man/systemd.time.7.html

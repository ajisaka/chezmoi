# vim:fileencoding=utf-8:ft=conf:foldmethod=marker
# chezmoi:template:left-delimiter="[[[" right-delimiter=]]]

# Fonts {{{

font_family      family="[[[ .font.terminal.family ]]]"
bold_font        auto
italic_font      auto
bold_italic_font auto
[[[- if eq .chezmoi.os "darwin" ]]]
font_size        [[[ int64 (mulf .font.terminal.size 1.3 (index .scales .chezmoi.hostname | default 1.0)) ]]]
[[[ else ]]]
font_size        [[[ int64 (mulf .font.terminal.size 0.9 (index .scales .chezmoi.hostname | default 1.0)) ]]]
[[[ end -]]]

adjust_line_height  0
adjust_column_width 0

box_drawing_scale 0.001, 1, 1.5, 2

# }}}

# Cursor customization {{{

cursor #cccccc
cursor_text_color #111111
cursor_shape block
cursor_blink_interval      0.5
cursor_stop_blinking_after 15.0

cursor_trail 0
cursor_trail_start_threshold 0

# }}}

# Scrollback {{{

scrollback_lines 20000
wheel_scroll_multiplier 5.0

scrollbar_handle_opacity 0.5

scrollback_pager nvim -c "set nonumber nolist showtabline=0 foldcolumn=0 laststatus=0 ft=man" -c "autocmd TermOpen * normal G" -c "silent write! /tmp/kitty_scrollback_buffer | te cat /tmp/kitty_scrollback_buffer; rm /tmp/kitty_scrollback_buffer; cat"

# }}}

# Mouse {{{

url_color #0087BD
url_style curly

click_interval               0.5
copy_on_select               no
focus_follows_mouse          no
mouse_hide_wait              3.0
open_url_with                default
select_by_word_characters    :@-./_~?&=%+#
# open_url_modifiers           kitty_mod
# rectangle_select_modifiers   ctrl+alt

# }}}

# Performance tuning {{{

repaint_delay     10
input_delay       3
sync_to_monitor   yes

# }}}

# Terminal bell {{{

enable_audio_bell      no
visual_bell_duration   0.0
window_alert_on_bell   yes
bell_on_tab            yes

# }}}

# Window layout {{{

remember_window_size         no
# initial_window_width  640
# initial_window_height 400

draw_minimal_borders         yes
single_window_margin_width   10
window_border_width          1.0
window_margin_width          0.0
window_padding_width         0.0
window_resize_step_cells     2
window_resize_step_lines     2

active_border_color          #00ff00
inactive_border_color        #cccccc
bell_border_color            #ff5a00
inactive_text_alpha          1.0

# }}}

# Tab bar {{{

tab_bar_edge           bottom
tab_bar_margin_width   0.0
tab_bar_style          powerline
tab_switch_strategy    right
tab_title_template    "{index}:{title}"

# }}}

# Advanced {{{

shell .
editor .
close_on_child_death no
startup_session none
clipboard_control write-clipboard write-primary
term xterm-kitty

# }}}

# cmp_kitty - https://github.com/garyhurtz/cmp_kitty {{{

# allow_remote_control socket-only
allow_remote_control socket
# allow_remote_control yes

# }}}

# Mac {{{
macos_quit_when_last_window_closed yes
# }}}

hide_window_decorations no

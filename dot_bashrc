# .env などを読み込む {{{
__bashrc_env_filename_patterns=(
  .env/bin/activate
  .venv/bin/activate
  venv/bin/activate
  .beethovenv
)

function __bashrc_find_named_beethovenv() {
  find ./ -maxdepth 1 -mindepth 1 -name '.beethovenv.*' -type f | sed 's/.*\.beethovenv\.//'
}

function __bashrc_find_env_dir() {
  local tried="$1"
  local dir="$2"

  # printf '\e[41mCheck: %q\e[41m\n' "$dir" 1>&2

  if [ "$tried" -gt 10 ]
  then
    # echo '\e[41mEnv not found\e[41m' 1>&2
    return 1
  fi

  for pattern in "${__bashrc_env_filename_patterns[@]}"
  do
    if [ -f "${dir}/${pattern}" ]
    then
      echo "$dir"
      return 0
    fi
  done

  local beethovenv_named=0
  beethovenv_named="$(__bashrc_find_named_beethovenv | wc -l)"
  if [ "$beethovenv_named" -gt 0 ]
  then
    echo "$dir"
    return 0
  fi

  __bashrc_find_env_dir "$(( tried + 1 ))" "$(dirname "$dir")"
}

function load-env {
  local dir
  dir="$( __bashrc_find_env_dir 0 "$PWD" )"
  if [ -z "$dir" ]
  then
    echo -e '\e[41menv dir is not found\e[0m'
    return
  fi

  for pattern in "${__bashrc_env_filename_patterns[@]}"
  do
    [ -f "${dir}/${pattern}" ] || continue
    local env
    env="$(realpath --relative-to "$PWD" "${dir}/${pattern}")"
    if [ -f "$env" ]
    then
      echo -e "\e[44msource ${env}\e[0m" 1>&2
      source "${dir}/${pattern}"
    fi
  done

  local named names
  names="$(__bashrc_find_named_beethovenv)"
  if [ -n "$names" ]
  then
    named="$(echo "$names" | anything)"
    if [ -n "$named" ]
    then
      local env
      env="$(realpath --relative-to "$PWD" ./".beethovenv.${named}")"
      echo -e "\e[44msource ${env}\e[0m" 1>&2
      source "${env}"
    fi
  fi
}

alias le=load-env

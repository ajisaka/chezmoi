snippet click/main
  import click


  @click.group()
  @click.pass_context
  def main(ctx: click.Context) -> None:
      # ctx.obj = App()
      pass


  @main.command("foo")
  def main_foo() -> None:
      print("foo")


  if __name__ == "__main__":
      main()


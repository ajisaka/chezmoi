# Enter 連打 {{{

# zshでEnterを連打したときにいろいろ実行する - @znz blog - https://blog.n-z.jp/blog/2014-12-06-zsh-enter.html

__anekos_ce_count=0

function consecutive_enter {
  if [[ -n "$BUFFER" ]]
  then
    builtin zle .accept-line
    return 0
  fi

  case $[ __anekos_ce_count++ ] in
    0)
      echo ''
      ls
      ;;
    1)
      if git rev-parse --is-inside-work-tree >/dev/null 2>&1
      then
        echo ''
        git status -sb
      fi
      __anekos_ce_count=0
      ;;
    *)
      __anekos_ce_count=0
      ;;
  esac
  builtin zle .accept-line
}

zle -N consecutive_enter
bindkey '^m' consecutive_enter


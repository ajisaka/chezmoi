function __aws-region-selector () {
  echo '
us-east-1 = US East (N. Virginia)
us-east-2 = US East (Ohio)
us-west-1 = US West (N. California)
us-west-2 = US West (Oregon)
ca-central-1 = Canada (Central)
eu-west-1 = EU (Ireland)
eu-central-1 = EU (Frankfurt)
eu-west-2 = EU (London)
ap-northeast-1 = Asia Pacific (Tokyo)
ap-northeast-2 = Asia Pacific (Seoul)
ap-southeast-1 = Asia Pacific (Singapore)
ap-southeast-2 = Asia Pacific (Sydney)
ap-south-1 = Asia Pacific (Mumbai)
sa-east-1 = South America (São Paulo)
  ' | anything | awk -F ' = ' '{print $1}'
}

function aws-select-region () {
  export AWS_DEFAULT_REGION="$(__aws-region-selector)"
  env | grep '^AWS'
  has-command hugo && hugo zsh-aws-env set --ttl '6 hours' "REGION" "$AWS_DEFAULT_REGION"
}

alias asr=aws-select-region

function __anekos_aws_profiles() {
  cat ~/.aws/{config,credentials} | grep '^\[' | sed 's/profile //' | tr --delete '[] ' | grep -v '^default$' | sort
}

function aws-select-profile () {
  local selected=""
  selected="$(__anekos_aws_profiles | anything)"
  [ -z "$selected" ] && return 1
  export AWS_PROFILE="$selected"
  env | grep '^AWS' | sed -e 's/^/export /'
  if [ -n "$AWS_PROFILE" ]
  then
    export AWS_DEFAULT_REGION=ap-northeast-1
  fi
  has-command hugo && hugo zsh-aws-env set --ttl '6 hours' "PROFILE" "$AWS_PROFILE"
}


# Frequently used code {{{

snippet freq/unwrap_or
  T = TypeVar("T")

  def unwrap_or(value: T | None, default: T) -> T:
      if value is None:
          return default
      return value

# }}}

snippet auto/cloudformation_output_parser
  import boto3

  from pydantic import BaseModel, Field

  class Outputs(BaseModel):
      ${1:arn}: str = Field(..., alias="${2:Arn}")


  def from_stack_outputs(stack_name: str) -> Outputs:
      cfn = boto3.client("cloudformation")

      raw = {}

      for entry in cfn.describe_stacks(StackName=stack_name)["Stacks"][0]["Outputs"]:
          raw[entry["OutputKey"]] = entry["OutputValue"]

      return Outputs.model_validate(raw)

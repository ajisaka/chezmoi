# Script finder <C-s> {{{

__anekos_script_dirs=()
__anekos_init_script_dirs(){
  local d
  local roots=(~/script/ ~/local/script/ ~/bin/ ~/lin/ ~/local/bin/)
  [ "$DESKTOP_SESSION" = hyprland ] && roots+=(~/.config/hypr/script)
  for d in $roots
  do
    [ -d "$d" ] && __anekos_script_dirs+=("$d")
  done
}
__anekos_init_script_dirs

find_script() {
  local home=~/
  {
    find "${__anekos_script_dirs[@]}" \( -type f -executable -or -type l \) | sed "s/^.\{${#home}\}//" | sed -e 's/^/!/'
    (
      print -l ${(ok)functions}
      alias -r | sed 's/=.*//'
    ) | grep '^[a-z]' | sort | sed -e 's/^/#/'
  } | grep '.\+'
}

select_script () {
  local found
  local cmd
  found=$(find_script | anything)
  found_type="${found:0:1}"
  found_path="${found:1}"
  if [ "$found_type" = '#' ]
  then
    cmd="$found_path"
  elif [[ $found_path =~ (^|/)bin/ ]]
  then
    cmd="$(basename "$found_path")"
  else
    cmd="~/$found_path"
  fi
  if [ -z "$BUFFER" ]
  then
    BUFFER="$cmd"
  else
    BUFFER="${BUFFER} ${cmd}"
  fi
  CURSOR=$#BUFFER         # move cursor
  zle -R -c               # refresh
}

zle -N select_script
bindkey '^S' select_script


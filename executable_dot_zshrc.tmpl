# 履歴に記録する条件 {{{
# http://d.hatena.ne.jp/mollifier/20090728/p1
_zshaddhistory_impl() {
  local line=${1%%$'\n'}
  local cmd_path="${line%% *}"
  local cmd="${cmd_path:t}"
  local exists=0

  if has-command "$cmd" || [[ $cmd_path =~ [~/] ]]
  then
    exists=1
  fi

  # 以下の条件をすべて満たすものだけをヒストリに追加する
  [[ ${#line} -ge 4
      && ${cmd} != (exit|halt|reboot)
      && ${cmd} != (rm|rmdir)
      && ${cmd} != (man)
      && ${cmd} != (l[salr])
      && ${cmd} != (c|cd)
      && ${exists} -eq 1
  ]]
}

zshaddhistory() {
  # 本体でエラーが起きても入力行の実行を巻き込まないよう subshell で隔離する
  ( _zshaddhistory_impl "$1" ) 2>/dev/null
}
